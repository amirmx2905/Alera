{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "include": ["."],
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix",
        "no-unversioned-import"
      ]
    }
  },
  "fmt": {
    "include": ["."],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "imports": {
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2"
  }
}
